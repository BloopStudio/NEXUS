; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is always guaranteed to be up to date.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NEXUS"
config/description="Survival/Wave/Idle multiplayer game — defend your station together"
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

NetworkManager="*res://scripts/autoload/network_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
FpsCounter="*res://scripts/autoload/fps_counter.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
I18n="*res://scripts/autoload/i18n.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SceneLoader="*res://scripts/autoload/scene_loader.gd"
ProfileStore="*res://scripts/autoload/profile_store.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

